<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="EditorSectionLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/editor_label</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="ShortcutCardButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="SheetActionRow" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>
    <style name="SegmentPillShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="OneUITitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/editor_text</item>
    </style>
</resources>
