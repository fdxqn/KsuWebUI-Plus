<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/editor_card"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:clipToOutline="true"
            app:cardBackgroundColor="@color/editor_field"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/sheet_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/sheet_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:textColor="@color/editor_text"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/sheet_disabled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/module_disabled"
        android:textColor="?attr/colorError"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_open"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="start|center_vertical"
        android:text="@string/action_open" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_add"
        style="@style/SheetActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_add_shortcut" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_edit"
        style="@style/SheetActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_edit_shortcut"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_remove"
        style="@style/SheetActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_remove_shortcut"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_info"
        style="@style/SheetActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_module_info" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/action_cancel"
        style="@style/SheetActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/action_cancel" />
</LinearLayout>
